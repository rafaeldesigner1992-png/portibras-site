{
  "headers": [
    {
      "source": "/calculadora/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/calculadora",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/calculadora",
      "destination": "/calculadora/index.html"
    },
    {
      "source": "/((?!calculadora).*)",
      "destination": "/index.html"
    }
  ]
}
